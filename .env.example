# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://rajdeepmajumdar.me

# Contact form (src/app/api/contact/route.js) — sends mail through SMTP.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
# Optional (defaults shown)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# CONTACT_TO_EMAIL=amazumder781@gmail.com
# CONTACT_FROM_EMAIL=you@gmail.com
